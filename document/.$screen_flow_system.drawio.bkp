        <mxCell id="ec-2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="c-dash" target="c-appr-p"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="lbl-ec-2" value="Review Proposal" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" vertex="1" connectable="0" parent="ec-2"><mxGeometry x="-0.1" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell>

        <mxCell id="ec-3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="c-dash" target="c-appr-po"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="lbl-ec-3" value="Review Purchase Order" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" vertex="1" connectable="0" parent="ec-3"><mxGeometry x="-0.1" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell>

