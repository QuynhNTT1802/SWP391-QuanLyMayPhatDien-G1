          <mxGeometry x="350" y="40" width="300" height="30" as="geometry" />
        </mxCell>
        
        <mxCell id="c-dash" value="CEO Dashboard" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="150" y="270" width="130" height="40" as="geometry" />
        </mxCell>

        <mxCell id="c-rep" value="Executive System Report" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="450" y="120" width="160" height="40" as="geometry" />
