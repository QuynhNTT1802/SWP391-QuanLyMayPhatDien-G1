        <mxCell id="c-appr-p" value="Approve Purchase Proposal" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="450" y="210" width="170" height="40" as="geometry" />
        </mxCell>

        <mxCell id="c-appr-po" value="Approve Purchase Order" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="450" y="290" width="160" height="40" as="geometry" />
        </mxCell>

        <mxCell id="c-appr-so" value="Approve Sales Order" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="450" y="370" width="160" height="40" as="geometry" />
        </mxCell>

        <mxCell id="c-appr-l" value="Approve Liquidation Request" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="450" y="450" width="180" height="40" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="ec-1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="c-dash" target="c-rep"><mxGeometry relative="1" as="geometry" /></mxCell>
