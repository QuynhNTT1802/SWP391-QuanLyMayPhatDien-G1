    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="950" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <mxCell id="title-wm" value="Warehouse Manager Screen Flow" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontStyle=1;fontSize=20;" vertex="1" parent="1">
          <mxGeometry x="400" y="30" width="400" height="30" as="geometry" />
        </mxCell>
        
        <mxCell id="wm-dash" value="Warehouse Dashboard" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="100" y="350" width="150" height="40" as="geometry" /></mxCell>

        <!-- Warehouse Info -->
        <mxCell id="wm-wh" value="Warehouse List" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="400" y="100" width="140" height="40" as="geometry" /></mxCell>
        <mxCell id="wm-wh-u" value="Update Warehouse" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="680" y="100" width="140" height="40" as="geometry" /></mxCell>

        <!-- Inventory Overview & Reports -->
        <mxCell id="wm-inv" value="Stock Overview" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="400" y="180" width="140" height="40" as="geometry" /></mxCell>
        <mxCell id="wm-inv-r" value="Inventory Report" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="680" y="180" width="140" height="40" as="geometry" /></mxCell>

        <!-- Transfer Approval -->
        <mxCell id="wm-trans" value="Transfer Requests" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="400" y="260" width="140" height="40" as="geometry" /></mxCell>
        <mxCell id="wm-trans-a" value="Approve Transfer" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="680" y="260" width="140" height="40" as="geometry" /></mxCell>

        <!-- Stock Audit Approval -->
        <mxCell id="wm-check" value="Stock Audit List" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="400" y="340" width="140" height="40" as="geometry" /></mxCell>
        <mxCell id="wm-check-a" value="Complete &amp; Audit Approval" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="680" y="340" width="170" height="40" as="geometry" /></mxCell>

        <!-- Liquidation -->
        <mxCell id="wm-liq" value="Equipment Liquidation" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="400" y="420" width="140" height="40" as="geometry" /></mxCell>
        <mxCell id="wm-liq-r" value="Liquidation Report" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="680" y="420" width="140" height="40" as="geometry" /></mxCell>

        <!-- Stock Cards -->
        <mxCell id="wm-sc" value="Stock Cards" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="400" y="500" width="140" height="40" as="geometry" /></mxCell>
        <mxCell id="wm-sc-r" value="Stock Card Report" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="680" y="500" width="140" height="40" as="geometry" /></mxCell>

        <!-- Suppliers -->
        <mxCell id="wm-sup" value="Supplier List" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="400" y="580" width="140" height="40" as="geometry" /></mxCell>
        <mxCell id="wm-sup-e" value="Add / Edit Supplier" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="680" y="580" width="140" height="40" as="geometry" /></mxCell>

        <!-- Connectors -->
        <mxCell id="ewm1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="wm-dash" target="wm-wh"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ewm2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="wm-dash" target="wm-inv"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ewm3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="wm-dash" target="wm-trans"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ewm4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="wm-dash" target="wm-check"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ewm5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="wm-dash" target="wm-liq"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ewm6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="wm-dash" target="wm-sc"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ewm7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="wm-dash" target="wm-sup"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="ewm-w" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="wm-wh" target="wm-wh-u"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ewm-i" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="wm-inv" target="wm-inv-r"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ewm-t" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="wm-trans" target="wm-trans-a"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ewm-c" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="wm-check" target="wm-check-a"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ewm-l" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="wm-liq" target="wm-liq-r"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ewm-s" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="wm-sc" target="wm-sc-r"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ewm-su" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="wm-sup" target="wm-sup-e"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <!-- ==================== PAGE 7: Admin & CEO screen flow ==================== -->
  <diagram name="Admin &amp; CEO screen flow" id="diag-admin-ceo">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <mxCell id="title-ac" value="System Admin &amp; CEO Screen Flow" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontStyle=1;fontSize=20;" vertex="1" parent="1">
          <mxGeometry x="350" y="40" width="400" height="30" as="geometry" />
        </mxCell>
        
        <!-- Admin Dashboard -->
