        <mxCell id="ac-cat" value="Category Management" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="400" y="240" width="150" height="40" as="geometry" /></mxCell>

        <!-- CEO Dashboard -->
        <mxCell id="ac-ceo" value="CEO Dashboard" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="120" y="420" width="140" height="40" as="geometry" /></mxCell>
        <mxCell id="ac-rep" value="Executive Report" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="400" y="360" width="140" height="40" as="geometry" /></mxCell>
        <mxCell id="ac-appr" value="Final Order &amp; Proposal Approval" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="400" y="440" width="190" height="40" as="geometry" /></mxCell>

        <!-- Connectors -->
        <mxCell id="eac-a1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="ac-adm" target="ac-user"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eac-a2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="ac-adm" target="ac-role"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eac-a3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="ac-adm" target="ac-cat"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="eac-c1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="ac-ceo" target="ac-rep"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eac-c2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="ac-ceo" target="ac-appr"><mxGeometry relative="1" as="geometry" /></mxCell>
