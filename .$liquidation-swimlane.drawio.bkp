<mxfile host="Electron" agent="Kiro">
  <diagram id="liquidation-swimlane-v2" name="Liquidation Workflow">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="650" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="lane_manager" parent="1" style="swimlane;html=1;horizontal=1;startSize=30;fillColor=default;swimlaneFillColor=#ffffff;fontStyle=1;fontSize=13;" value="Warehouse Manager" vertex="1">
          <mxGeometry height="550" width="440" x="40" y="60" as="geometry" />
        </mxCell>
        <mxCell id="n_start" parent="lane_manager" style="ellipse;html=1;shape=startState;fillColor=#000000;strokeColor=#000000;" vertex="1">
          <mxGeometry height="30" width="30" x="205" y="20" as="geometry" />
        </mxCell>
        <mxCell id="n_create" parent="lane_manager" style="rounded=0;whiteSpace=wrap;html=1;arcSize=20;fillColor=#fff2cc;strokeColor=default;fontSize=12;" value="Tạo đơn thanh lý&lt;br&gt;(chọn kho, máy, giá, KH)" vertex="1">
          <mxGeometry height="55" width="170" x="135" y="90" as="geometry" />
        </mxCell>
        <mxCell id="e_start" edge="1" parent="lane_manager" source="n_start" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;fontSize=11;" target="n_create">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n_edit" parent="lane_manager" style="rounded=0;whiteSpace=wrap;html=1;arcSize=20;fillColor=#fff2cc;strokeColor=default;fontSize=12;" value="Chỉnh sửa đơn&lt;br&gt;(thay đổi giá, máy...)" vertex="1">
          <mxGeometry height="55" width="170" x="135" y="370" as="geometry" />
        </mxCell>
        <mxCell id="lane_ceo" parent="1" style="swimlane;html=1;horizontal=1;startSize=30;fillColor=default;swimlaneFillColor=#ffffff;fontStyle=1;fontSize=13;" value="CEO" vertex="1">
          <mxGeometry height="550" width="440" x="540" y="60" as="geometry" />
        </mxCell>
        <mxCell id="n_ceo_review" parent="lane_ceo" style="rounded=0;whiteSpace=wrap;html=1;arcSize=20;fillColor=#fff2cc;strokeColor=default;fontSize=12;" value="Xem xét đơn thanh lý&lt;br&gt;(PENDING_CEO)" vertex="1">
          <mxGeometry height="55" width="170" x="135" y="90" as="geometry" />
        </mxCell>
        <mxCell id="d_ceo_decision" parent="lane_ceo" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=default;fontSize=11;" value="Quyết định?" vertex="1">
          <mxGeometry height="80" width="180" x="130" y="205" as="geometry" />
        </mxCell>
        <mxCell id="e_review_dec" edge="1" parent="lane_ceo" source="n_ceo_review" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;fontSize=11;" target="d_ceo_decision">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n_approved" parent="lane_ceo" style="rounded=0;whiteSpace=wrap;html=1;arcSize=20;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" value="Đã duyệt (APPROVED)" vertex="1">
          <mxGeometry height="40" width="150" x="30" y="350" as="geometry" />
        </mxCell>
        <mxCell id="n_cancelled" parent="lane_ceo" style="rounded=0;whiteSpace=wrap;html=1;arcSize=20;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;" value="Đã hủy (CANCELLED)" vertex="1">
          <mxGeometry height="40" width="150" x="260" y="350" as="geometry" />
        </mxCell>
        <mxCell id="n_end_approve" parent="lane_ceo" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1">
          <mxGeometry height="30" width="30" x="90" y="430" as="geometry" />
        </mxCell>
        <mxCell id="n_end_cancel" parent="lane_ceo" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1">
          <mxGeometry height="30" width="30" x="320" y="430" as="geometry" />
        </mxCell>
        <mxCell id="e_approve" edge="1" parent="lane_ceo" source="d_ceo_decision" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;fontSize=11;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="n_approved" value="Duyệt">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="229" y="320" />
              <mxPoint x="105" y="320" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_reject" edge="1" parent="lane_ceo" source="d_ceo_decision" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;fontSize=11;exitX=0.7;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="n_cancelled" value="Từ chối">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="306" y="320" />
              <mxPoint x="335" y="320" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_approved_end" edge="1" parent="lane_ceo" source="n_approved" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="n_end_approve">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_cancelled_end" edge="1" parent="lane_ceo" source="n_cancelled" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="n_end_cancel">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_submit" edge="1" parent="1" source="n_create" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="n_ceo_review" value="Gửi duyệt">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_resubmit" edge="1" parent="1" source="n_edit" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="n_ceo_review" value="Gửi lại">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="490" y="458" />
              <mxPoint x="490" y="178" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_request_edit" edge="1" parent="1" source="d_ceo_decision" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;fontSize=11;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" target="n_edit" value="Yêu cầu sửa">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="490" y="305" />
              <mxPoint x="490" y="458" />
            </Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
